{
  "extractor": {
    "base-directory": "/home/moon/Downloads/gallery-dl",
    "archive": "/home/moon/.local/share/gallery-dl/archive.sqlite3",
    "archive-pragma": ["journal_mode=WAL", "synchronous=NORMAL"],
    "skip": true,
    "path-restrict": "windows+",
    "path-strip": "auto",
    "cookies-update": true,

    "twitter": {
      "cookies": [
        "firefox",
        "/home/moon/.var/app/io.gitlab.librewolf-community/.librewolf/swh32wvy.default-default",
        null,
        "all"
      ],
      "size": ["large", "medium", "small"],
      "include": ["timeline"],
      "timeline": {
        "strategy": "tweets"
      },
      "text-tweets": true,
      "retweets": false,
      "videos": true,
      "pinned": false,
      "directory": ["x", "{author[name]}"],
      "filename": "{tweet_id}_{author[name]}_{num}.{extension}",
      "postprocessors": [
        {
          "name": "metadata",
          "event": "post",
          "mode": "custom",
          "filename": "{tweet_id}_{author[name]}.txt",
          "content-format": "{content}\n"
        }
      ]
    },

    "instagram": {
      "cookies": [
        "firefox",
        "/home/moon/.var/app/io.gitlab.librewolf-community/.librewolf/swh32wvy.default-default",
        null,
        null,
        ".instagram.com"
      ],
      "browser": "firefox",
      "include": ["posts", "reels"],
      "videos": "ytdl",
      "directory": ["instagram", "{username}"],
      "filename": "{shortcode}_{num}.{extension}",
      "postprocessors": [
        {
          "name": "metadata",
          "event": "post",
          "mode": "json",
          "filename": "{shortcode}.json"
        }
      ]
    },

    "reddit": {
      "videos": "ytdl",
      "comments": 1,
      "morecomments": false,
      "selftext": true,
      "embeds": false,
      "recursion": 0,
      "previews": true,
      "parent-directory": true,
      "parent-metadata": "_reddit",
      "category-transfer": true,
      "directory": ["reddit", "{author}"],
      "filename": "{title[:120]}_{id}_{num}.{extension}",
      "postprocessors": [
        {
          "name": "metadata",
          "event": "post",
          "mode": "custom",
          "filename": "{title[:120]}_{id}.txt",
          "content-format": "{title}\n\n{selftext}\n"
        }
      ]
    }
  },

  "downloader": {
    "ytdl": {
      "format": "bv*+ba/b",
      "cmdline-args": [
        "--format-sort-reset",
        "-S",
        "height:720,+size,+br",
        "--merge-output-format",
        "mp4"
      ]
    }
  }
}
