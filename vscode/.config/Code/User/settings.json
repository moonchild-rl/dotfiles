{
  // Workflow
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 200,
  "files.autoSaveWhenNoErrors": true,
  "files.autoSaveWorkspaceFilesOnly": true,
  "workbench.settings.editor": "json",
  "workbench.startupEditor": "none",
  "update.showReleaseNotes": false,

  // Appearance
  "workbench.colorTheme": "Dracula Theme",
  "workbench.iconTheme": "material-icon-theme",
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'Noto Sans Mono', monospace",
  "markdown-preview-enhanced.previewTheme": "vscode.css",
  "markdown-preview-enhanced.codeBlockTheme": "auto.css",
  "markdown-preview-enhanced.mermaidTheme": "dark",

  // Editor display
  "editor.guides.bracketPairs": true, // Favorite setting
  "editor.rulers": [88, 100],
  "editor.renderWhitespace": "boundary",
  "editor.renderControlCharacters": true,

  // Formatting
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",

  // File hygiene
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",

  // Git
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",

  // Privacy / experiments / retained history
  "chat.disableAIFeatures": true,
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  "workbench.enableExperiments": false,
  "python.experiments.enabled": false,
  "terminal.integrated.shellIntegration.history": 0,

  // Extensions
  "parquet-viewer.format": "csv",

  // Language-specific overrides
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit",
    },
  },

  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
  },
}
