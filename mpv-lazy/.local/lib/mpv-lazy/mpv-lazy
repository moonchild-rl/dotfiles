#!/usr/bin/env python3
"""mpv-lazy: single-instance mpv with lazy directory navigation."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time

SCRIPT_NAME = "mpv_lazy"  # mpv normalizes mpv-lazy.lua -> mpv_lazy
READY_PROPERTY = "user-data/mpv-lazy/ready"


def ipc_request(sock_path: Path, command: list[str], timeout: float = 0.5):
    """Run one JSON IPC command and return the matching reply (or None)."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(str(sock_path))
            sock.sendall((json.dumps({"command": command, "request_id": 1}) + "\n").encode())
            with sock.makefile("rb") as response:
                for line in response:
                    message = json.loads(line)
                    if message.get("request_id") == 1:
                        return message
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError):
        pass
    return None


def ready(sock_path: Path) -> bool:
    reply = ipc_request(sock_path, ["get_property", READY_PROPERTY])
    return bool(reply and reply.get("error") == "success" and reply.get("data") is True)


def send_open(sock_path: Path, target: Path, root: Path) -> bool:
    reply = ipc_request(sock_path, ["script-message-to", SCRIPT_NAME, "open", str(target), str(root)])
    return bool(reply and reply.get("error") == "success")


def log_tail(log_path: Path, limit: int = 30) -> str:
    try:
        lines = log_path.read_text(errors="replace").splitlines()
        return "\n".join(lines[-limit:]) or "(mpv produced no diagnostic output)"
    except OSError:
        return "(mpv log unavailable)"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("target", type=Path, help="Media file or directory")
    parser.add_argument("--root", type=Path, help="Ancestor directory to traverse")
    args = parser.parse_args()

    target = args.target.expanduser().resolve()
    if not target.exists() or not (target.is_file() or target.is_dir()):
        parser.error(f"Not a regular file or directory: {target}")
    root = args.root.expanduser().resolve() if args.root else (target if target.is_dir() else target.parent)
    if not root.is_dir() or (root != target and root not in target.parents):
        parser.error("--root must be an existing ancestor directory of the selected target")

    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        parser.error("XDG_RUNTIME_DIR is unset; launch mpv-lazy from a desktop user session")
    state = Path(runtime) / "mpv-lazy"
    state.mkdir(mode=0o700, exist_ok=True)
    state.chmod(0o700)
    sock_path = state / "mpv.sock"
    log_path = state / "mpv.log"

    # Avoid racing when multiple videos are opened nearly simultaneously.
    with (state / "lock").open("w") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if ready(sock_path):
            if send_open(sock_path, target, root):
                return 0
            parser.error(f"Unable to send media to existing mpv instance. Log: {log_path}")

        # A reachable socket might belong to a still-starting instance.
        if ipc_request(sock_path, ["get_property", "mpv-version"]) is not None:
            for _ in range(30):
                if ready(sock_path):
                    if send_open(sock_path, target, root):
                        return 0
                    break
                time.sleep(0.1)
            parser.error(f"An mpv instance exists but its mpv-lazy script is not ready. Log: {log_path}")

        # Only a genuinely stale or absent socket is removed.
        sock_path.unlink(missing_ok=True)
        lua = Path(__file__).resolve().with_name("mpv-lazy.lua")
        if not lua.is_file():
            parser.error(f"Missing Lua script beside launcher: {lua}")

        cmd = [
            "mpv", "--no-config", "--idle=yes", "--force-window=yes",
            "--image-display-duration=inf", "--keep-open=no",
            "--volume=50",
            f"--script={lua}", f"--input-ipc-server={sock_path}",
        ]
        try:
            # Keep diagnostic output instead of silently discarding errors.
            with log_path.open("w") as log:
                proc = subprocess.Popen(
                    cmd, stdin=subprocess.DEVNULL, stdout=log,
                    stderr=subprocess.STDOUT, start_new_session=True,
                )
        except FileNotFoundError:
            parser.error("mpv is not installed")

        for _ in range(80):
            if proc.poll() is not None:
                parser.error(f"mpv exited during startup. See {log_path}:\n{log_tail(log_path)}")
            if ready(sock_path):
                if send_open(sock_path, target, root):
                    return 0
                parser.error(f"Unable to open the selected media. See {log_path}:\n{log_tail(log_path)}")
            time.sleep(0.1)
        parser.error(f"mpv-lazy Lua script did not become ready. See {log_path}:\n{log_tail(log_path)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
