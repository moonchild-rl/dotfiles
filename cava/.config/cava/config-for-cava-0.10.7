[general]

# Reload the configuration automatically whenever the file is saved.
live-config = 1

# Make each bar multiple terminal cells wide.
bar_width = 6

# Remove gaps between neighboring bars.
bar_spacing = 0

# Maximum bar height as a percentage of the available terminal height.
max_height = 50

# Enter low-processing sleep mode after this many seconds without audio.
sleep_timer = 5


[output]

# Required for horizontal gradients in terminal output.
method = noncurses


[color]

theme = 'dracula'


[smoothing]

# Balance responsiveness against visual smoothness.
noise_reduction = 86

# Smooth the shape across neighboring frequency bars.
monstercat = 1
