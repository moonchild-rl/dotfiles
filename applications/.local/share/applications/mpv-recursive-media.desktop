[Desktop Entry]
Type=Application
Name=MPV Recursive Media
Comment=Browse images and videos recursively with mpv
Exec=/home/moon/.local/bin/mpv-recursive-media --gui %f
Icon=mpv
Terminal=false
Categories=AudioVideo;Viewer;
MimeType=inode/directory;image/jpeg;image/png;image/gif;image/webp;image/avif;image/bmp;image/tiff;image/heic;image/heif;image/jxl;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/x-ms-wmv;video/x-flv;video/mp2t;video/ogg;video/3gpp;video/3gpp2;
StartupNotify=true
