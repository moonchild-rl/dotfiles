#!/usr/bin/env bash

set -euo pipefail

clicked="$(readlink -f -- "$1")"
dir="$(dirname -- "$clicked")"

# Temporary playlist
playlist="$(mktemp --tmpdir="$XDG_RUNTIME_DIR" --suffix=.m3u)"
trap 'rm -f -- "$playlist"' EXIT

# Find common video formats, ordered by modification time:
# oldest -> newest.
mapfile -d '' files < <(
    find "$dir" -maxdepth 1 -type f \
        \( -iname '*.mp4' \
        -o -iname '*.mkv' \
        -o -iname '*.webm' \
        -o -iname '*.avi' \
        -o -iname '*.mov' \
        -o -iname '*.m4v' \
        -o -iname '*.mpg' \
        -o -iname '*.mpeg' \
        -o -iname '*.wmv' \
        -o -iname '*.flv' \
        -o -iname '*.ts' \
        -o -iname '*.mts' \
        -o -iname '*.m2ts' \) \
        -printf '%T@ %p\0' |
    sort -zn |
    cut -z -d ' ' -f2-
)

# Locate the clicked file in the list
start=-1

for i in "${!files[@]}"; do
    if [[ "${files[i]}" == "$clicked" ]]; then
        start="$i"
        break
    fi
done

if (( start < 0 )); then
    vlc --one-instance --no-playlist-enqueue -- "$clicked"
    exit
fi

printf '#EXTM3U\n' > "$playlist"

count="${#files[@]}"

# Rotate the modification-time-sorted list so the clicked video is first.
#
# Example:
#
#   oldest
#   older
#   CLICKED
#   newer
#   newest
#
# becomes:
#
#   CLICKED
#   newer
#   newest
#   oldest
#   older
#
# Therefore:
#   Next     -> next newer file
#   Previous -> next older file
for ((n = 0; n < count; n++)); do
    i=$(( (start + n) % count ))
    printf '%s\n' "${files[i]}" >> "$playlist"
done

vlc --one-instance --no-playlist-enqueue --loop -- "$playlist"
