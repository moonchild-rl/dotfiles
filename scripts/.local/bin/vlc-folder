#!/usr/bin/env bash

set -euo pipefail

clicked="$(readlink -f -- "$1")"
dir="$(dirname -- "$clicked")"

# PID of the VLC instance managed by this launcher.
pidfile="$XDG_RUNTIME_DIR/vlc-folder.pid"

# Temporary playlist
playlist="$(mktemp --tmpdir="$XDG_RUNTIME_DIR" --suffix=.m3u)"

vlc_pid=""

cleanup() {
    rm -f -- "$playlist"

    # Remove the PID file only if it still belongs to our VLC.
    # This avoids an older invocation deleting a newer one's PID file.
    if [[ -n "$vlc_pid" && -r "$pidfile" ]]; then
        if [[ "$(<"$pidfile")" == "$vlc_pid" ]]; then
            rm -f -- "$pidfile"
        fi
    fi
}

trap cleanup EXIT

# Find common video formats, ordered by modification time:
# oldest -> newest.
mapfile -d '' files < <(
    find "$dir" -maxdepth 1 -type f \
        \( -iname '*.mp4' \
        -o -iname '*.mkv' \
        -o -iname '*.webm' \
        -o -iname '*.avi' \
        -o -iname '*.mov' \
        -o -iname '*.m4v' \
        -o -iname '*.mpg' \
        -o -iname '*.mpeg' \
        -o -iname '*.wmv' \
        -o -iname '*.flv' \
        -o -iname '*.ts' \
        -o -iname '*.mts' \
        -o -iname '*.m2ts' \) \
        -printf '%T@ %p\0' |
    sort -zn |
    cut -z -d ' ' -f2-
)

# Locate the clicked file in the list.
start=-1

for i in "${!files[@]}"; do
    if [[ "${files[i]}" == "$clicked" ]]; then
        start="$i"
        break
    fi
done

if (( start < 0 )); then
    printf '#EXTM3U\n%s\n' "$clicked" > "$playlist"
else
    printf '#EXTM3U\n' > "$playlist"

    count="${#files[@]}"

    # Rotate the modification-time-sorted list so the clicked video is first.
    for ((n = 0; n < count; n++)); do
        i=$(( (start + n) % count ))
        printf '%s\n' "${files[i]}" >> "$playlist"
    done
fi

# Stop the previous VLC instance started by THIS launcher.
if [[ -r "$pidfile" ]]; then
    old_pid="$(<"$pidfile")"

    # Make sure it looks like a valid PID and is still running.
    if [[ "$old_pid" =~ ^[0-9]+$ ]] && kill -0 "$old_pid" 2>/dev/null; then

        # Extra safety: don't kill the PID if it has been reused by some
        # unrelated process.
        if [[ -r "/proc/$old_pid/comm" ]] &&
           [[ "$(<"/proc/$old_pid/comm")" == "vlc" ]]; then
            kill "$old_pid"
        fi
    fi
fi

# Start a completely fresh VLC instance.
#
# --no-one-instance is intentional here: this script manages its own
# VLC instance instead of relying on VLC's one-instance mechanism.
vlc --no-one-instance --loop -- "$playlist" &

vlc_pid=$!
printf '%s\n' "$vlc_pid" > "$pidfile"

# Keep this script alive for as long as VLC is running.
# That also keeps the temporary M3U around until VLC exits.
wait "$vlc_pid"
