#!/usr/bin/env bash

set -euo pipefail

if (( $# != 1 )); then
    printf 'Usage: %s VIDEO\n' "$0" >&2
    exit 2
fi

: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"

clicked="$(readlink -f -- "$1")"
dir="$(dirname -- "$clicked")"

# Private runtime state for this launcher.
state_dir="$XDG_RUNTIME_DIR/vlc-folder"
socket="$state_dir/control.sock"
lockfile="$state_dir/lock"

# Keep files created here private to the current user.
umask 077
mkdir -p -- "$state_dir"

# Serialize multiple very rapid clicks. Without this, two copies of this
# script could both try to modify/start VLC at the same time.
exec 9>"$lockfile"
flock -x 9

# Use a unique playlist for each invocation.
#
# IMPORTANT:
# Do NOT delete this playlist immediately when the script exits.
# VLC may still be parsing it after the RC command has returned.
#
# These tiny files live under XDG_RUNTIME_DIR and therefore do not persist
# across login sessions/reboots.
playlist="$(mktemp --tmpdir="$state_dir" 'playlist.XXXXXX.m3u')"

# Find common video formats, ordered by modification time:
# oldest -> newest.
mapfile -d '' files < <(
    find "$dir" -maxdepth 1 -type f \
        \( -iname '*.mp4' \
        -o -iname '*.mkv' \
        -o -iname '*.webm' \
        -o -iname '*.avi' \
        -o -iname '*.mov' \
        -o -iname '*.m4v' \
        -o -iname '*.mpg' \
        -o -iname '*.mpeg' \
        -o -iname '*.wmv' \
        -o -iname '*.flv' \
        -o -iname '*.ts' \
        -o -iname '*.mts' \
        -o -iname '*.m2ts' \) \
        -printf '%T@ %p\0' |
    sort -zn |
    cut -z -d ' ' -f2-
)

# Locate the clicked file in the list.
start=-1

for i in "${!files[@]}"; do
    if [[ "${files[i]}" == "$clicked" ]]; then
        start="$i"
        break
    fi
done

printf '#EXTM3U\n' > "$playlist"

if (( start < 0 )); then
    # Should normally never happen.
    printf '%s\n' "$clicked" >> "$playlist"
else
    count="${#files[@]}"

    # Rotate the mtime-sorted list so that the clicked video is first.
    #
    # Example:
    #
    #   test1  oldest
    #   test2
    #   test3  CLICKED
    #   test4  newest
    #
    # becomes:
    #
    #   test3
    #   test4
    #   test1
    #   test2
    #
    # Therefore:
    #   Next     -> next newer file
    #   Previous -> next older file
    for ((n = 0; n < count; n++)); do
        i=$(( (start + n) % count ))
        printf '%s\n' "${files[i]}" >> "$playlist"
    done
fi

# If our controlled VLC already exists, talk directly to it.
if [[ -S "$socket" ]]; then
    if {
        printf 'clear\n'
        printf 'add %s\n' "$playlist"
        printf 'loop on\n'
        printf 'logout\n'
    } | socat - "UNIX-CONNECT:$socket" >/dev/null 2>&1
    then
        exit 0
    fi

    # The socket exists but can't be contacted, so it is most likely stale.
    rm -f -- "$socket"
fi

# No controllable VLC instance exists.
#
# Start a fresh VLC with the RC interface enabled.
#
# --no-one-instance is deliberate here. This launcher manages its own VLC
# instance through the socket. Once it exists, future invocations do not
# launch VLC at all; they send commands to this instance.
vlc \
    --no-one-instance \
    --extraintf=oldrc \
    --rc-unix="$socket" \
    --rc-fake-tty \
    --loop \
    -- "$playlist" &

vlc_pid=$!

# Keep the lock until VLC has had a chance to create its control socket.
# This prevents two very rapid double-clicks from both starting VLC before
# the first instance is ready.
for ((i = 0; i < 100; i++)); do
    if [[ -S "$socket" ]]; then
        break
    fi

    if ! kill -0 "$vlc_pid" 2>/dev/null; then
        break
    fi

    sleep 0.02
done

# Other invocations may now use the socket.
flock -u 9

# Keep this launcher process around for the VLC instance it started.
# This is harmless and also gives VLC a normal parent process until it exits.
wait "$vlc_pid"
