#!/usr/bin/env bash

set -u -o pipefail

# DE-launched processes do not necessarily inherit the PATH configured by interactive zsh.
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:$PATH"

app="download-current-post"

config="${XDG_CONFIG_HOME:-$HOME/.config}/gallery-dl/${app}.json"
download_root="$HOME/Downloads/$app"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/${app}"
runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/${app}"

reddit_max_wait="${BURL_MAX_WAIT_TIME:-300}"

# Socket configured for ydotoold.
export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-/run/ydotool/socket}"

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="$app" "$@"
    fi
}

require() {
    if ! command -v "$1" >/dev/null 2>&1; then
        notify "Download failed" "Required command not found: $1"
        return 127
    fi
}

is_niri() {
    # NIRI_SOCKET is normally present for processes launched from niri.
    if [[ -n "${NIRI_SOCKET:-}" ]]; then
        return 0
    fi

    # Fallback in case the environment is slightly different.
    case "${XDG_CURRENT_DESKTOP:-}" in
        *niri*|*Niri*)
            return 0
            ;;
    esac

    return 1
}

send_browser_copy_keys_wtype() {
    if ! command -v wtype >/dev/null 2>&1; then
        notify \
            "Download failed" \
            "Running under niri, but wtype is not installed."
        return 127
    fi

    # Ctrl+L -> select URL
    # Ctrl+C -> copy URL
    # Escape/F6 -> return focus to page
    wtype \
        -M ctrl l -m ctrl \
        -s 100 \
        -M ctrl c -m ctrl \
        -s 100 \
        -P Escape -p Escape \
        -s 50 \
        -P F6 -p F6
}

send_browser_copy_keys_ydotool() {
    if ! command -v ydotool >/dev/null 2>&1; then
        notify \
            "Download failed" \
            "This desktop requires ydotool, but ydotool is not installed.

On Fedora, install it with:
sudo dnf install ydotool

Then configure and start ydotoold."
        return 127
    fi

    if [[ ! -S "$YDOTOOL_SOCKET" ]]; then
        notify \
            "Download failed" \
            "ydotool is installed, but its daemon socket was not found:

$YDOTOOL_SOCKET

Check:
sudo systemctl status ydotool.service

If needed, start it with:
sudo systemctl enable --now ydotool.service"
        return 1
    fi

    # Linux input key codes:
    #   Ctrl   = 29
    #   L      = 38
    #   C      = 46
    #   Escape = 1
    #   F6     = 64

    # Ctrl+L
    if ! ydotool key 29:1 38:1 38:0 29:0; then
        notify \
            "Download failed" \
            "ydotool could not send keyboard input.

Check:
sudo systemctl status ydotool.service

Also make sure your user can access:
$YDOTOOL_SOCKET

If you recently added yourself to the ydotool group, log out and back in."
        return 1
    fi

    sleep 0.10

    # Ctrl+C
    if ! ydotool key 29:1 46:1 46:0 29:0; then
        notify "Download failed" "ydotool failed while sending Ctrl+C."
        return 1
    fi

    sleep 0.10

    # Escape
    if ! ydotool key 1:1 1:0; then
        notify "Download failed" "ydotool failed while sending Escape."
        return 1
    fi

    sleep 0.05

    # F6
    if ! ydotool key 64:1 64:0; then
        notify "Download failed" "ydotool failed while sending F6."
        return 1
    fi
}

copy_current_browser_url() {
    if is_niri; then
        send_browser_copy_keys_wtype
    else
        send_browser_copy_keys_ydotool
    fi
}

install -d -m 700 "$state_dir" "$runtime_dir" "$download_root"

# Optional explicit URL:
#
#   download-post https://example.com/post
#
# With no argument, get the current browser URL automatically.
if (( $# > 1 )); then
    notify "Download failed" "Usage: download-post [URL]"
    exit 2
elif (( $# == 1 )); then
    url="$1"
else
    require wl-copy || exit $?
    require wl-paste || exit $?

    # Give the user time to release Mod+Shift+D.
    sleep 0.15

    # Prevent reuse of an old clipboard URL if copying fails.
    wl-copy --clear

    if ! copy_current_browser_url; then
        exit 1
    fi

    url=""

    # Wait up to roughly one second for the new URL.
    for _ in {1..20}; do
        if candidate="$(wl-paste --no-newline --type text 2>/dev/null)" &&
           [[ "$candidate" =~ ^https?://[^[:space:]]+$ ]]; then
            url="$candidate"
            break
        fi

        sleep 0.05
    done

    if [[ -z "$url" ]]; then
        notify "Download failed" "Could not copy the current page URL."
        exit 1
    fi
fi

# Handle CRLF clipboard contents.
url="${url//$'\r'/}"

# Accept exactly one HTTP(S) URL.
if [[ ! "$url" =~ ^https?://[^[:space:]]+$ ]]; then
    notify \
        "Download failed" \
        "Input does not contain exactly one HTTP(S) URL."
    exit 1
fi

require flock || exit $?
require sha256sum || exit $?

# Prevent the same URL from running simultaneously.
lock_id="$(printf '%s' "$url" | sha256sum | cut -d' ' -f1)"

exec 9>"$runtime_dir/$lock_id.lock"

if ! flock -n 9; then
    notify "Already downloading" "That URL is already being processed."
    exit 0
fi

# Temporary logs.
log_file="$(mktemp "$runtime_dir/run.XXXXXX.log")"
bdfr_log=""

cleanup() {
    rm -f -- "$log_file"

    if [[ -n "${bdfr_log:-}" ]]; then
        rm -f -- "$bdfr_log"
    fi
}

trap cleanup EXIT

notify "Downloading post" "$url"

# Reddit currently blocks gallery-dl's anonymous REST requests on this
# connection. Route Reddit directly through BDFR instead.
case "$url" in
    http://reddit.com/*|https://reddit.com/*|\
    http://*.reddit.com/*|https://*.reddit.com/*|\
    http://redd.it/*|https://redd.it/*)

        require bdfr || exit $?

        bdfr_log="$(mktemp "$runtime_dir/bdfr.XXXXXX.log")"

        failure_re='(\[[^]]*[[:space:]]-[[:space:]]*(ERROR|CRITICAL)\][[:space:]]*-)|(^|[[:space:]\[])(ERROR|CRITICAL)([[:space:]\]:-]|$)|Traceback \(most recent call last\)|Max retries exceeded|Max wait time exceeded'

        bdfr download "$download_root" \
            --folder-scheme '{REDDITOR}/reddit' \
            --file-scheme '{TITLE}_{POSTID}_{REDDITOR}' \
            --filename-restriction-scheme windows \
            --log "$bdfr_log" \
            --max-wait-time "$reddit_max_wait" \
            -l "$url" \
            >"$log_file" 2>&1

        rc=$?

        {
            printf '\n--- BDFR internal log ---\n'
            cat "$bdfr_log"
        } >>"$log_file"

        if (( rc == 0 )) &&
           ! grep -Eq -- "$failure_re" "$bdfr_log"; then
            success=true
        else
            success=false
        fi
        ;;

    *)
        require gallery-dl || exit $?

        if [[ ! -r "$config" ]]; then
            notify "Download failed" "Missing config: $config"
            exit 1
        fi

        if gallery-dl -c "$config" -d "$download_root" -- "$url" >"$log_file" 2>&1; then
            success=true
        else
            success=false
        fi
        ;;
esac

if [[ "$success" == true ]]; then
    notify "Download finished" "$url"
else
    tail -n 200 "$log_file" >"$state_dir/last-error.log"

    notify \
        "Download failed" \
        "See $state_dir/last-error.log"

    exit 1
fi
