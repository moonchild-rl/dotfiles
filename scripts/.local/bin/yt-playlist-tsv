#!/usr/bin/env python3
# Usage:
#   yt-playlist-tsv PLAYLIST_URL
#   yt-playlist-tsv --name my-playlist PLAYLIST_URL
#   yt-playlist-tsv --cookies-from-browser firefox PLAYLIST_URL
#   yt-playlist-tsv --cookies ~/path/to/cookies.txt PLAYLIST_URL
#
# Output:
#   ~/Downloads/yt-backup/inventories/<playlist-id-or-name>.tsv
#
# The TSV is an inventory. It keeps unavailable playlist entries when
# YouTube still exposes their ID, and it retains earlier rows as "removed" when
# an ID disappears from a later playlist extraction.

from __future__ import annotations

import argparse
import csv
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from collections import defaultdict, deque
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import parse_qs, urlparse

BASE_DIR = Path.home() / "Downloads" / "yt-backup"
INVENTORY_DIR = BASE_DIR / "inventories"
YTDLP = "yt-dlp"
MIN_SAFE_YTDLP = (2026, 7, 4)  # Fixes YouTube playlist pagination truncation.

FIELDS = [
    "playlist_index",
    "status",
    "id",
    "url",
    "title",
    "uploader",
    "first_seen_utc",
    "last_seen_utc",
    "previous_title",
]

SAFE_STEM_RE = re.compile(r"[^A-Za-z0-9._-]+")
DELETED_TITLES = {"deleted video", "video deleted"}
PRIVATE_TITLES = {"private video", "video private"}
UNAVAILABLE_TITLES = {"unavailable video", "video unavailable"}


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def die(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def warn(message: str) -> None:
    print(f"warning: {message}", file=sys.stderr)


def require_tool(name: str) -> None:
    if shutil.which(name) is None:
        die(f"required command not found in PATH: {name}")


def validate_http_url(value: str) -> str:
    parsed = urlparse(value)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise argparse.ArgumentTypeError("expected an http(s) playlist URL")
    return value


def playlist_stem(url: str, override: str | None) -> str:
    if override:
        stem = override
    else:
        parsed = urlparse(url)
        qs = parse_qs(parsed.query)
        if qs.get("list"):
            stem = qs["list"][0]
        else:
            stem = "playlist-" + hashlib.sha256(url.encode("utf-8")).hexdigest()[:16]

    stem = SAFE_STEM_RE.sub("_", stem).strip("._-")
    return stem or "playlist"


def check_ytdlp_version() -> None:
    proc = subprocess.run(
        [YTDLP, "--version"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if proc.returncode != 0:
        warn("could not determine yt-dlp version")
        return

    version = proc.stdout.strip()
    match = re.fullmatch(r"(\d{4})\.(\d{2})\.(\d{2})(?:\.\d+)?", version)
    if not match:
        # Nightly/master builds do not necessarily use the stable date format.
        warn(f"could not compare yt-dlp version automatically: {version}")
        return

    parsed = tuple(int(part) for part in match.groups())
    if parsed < MIN_SAFE_YTDLP:
        die(
            f"yt-dlp {version} is too old for reliable large YouTube playlist extraction; "
            "install version 2026.07.04 or newer"
        )


def run_ytdlp(url: str, args: argparse.Namespace) -> dict:
    cmd = [
        YTDLP,
        "--ignore-config",
        "--no-progress",
        "--no-abort-on-error",
        "--yes-playlist",
        "--flat-playlist",
        "--dump-single-json",
    ]

    if args.cookies:
        cmd.extend(["--cookies", str(args.cookies)])

    if args.cookies_from_browser:
        cmd.extend(["--cookies-from-browser", args.cookies_from_browser])

    cmd.append(url)

    # Keep stderr attached to the terminal so yt-dlp warnings stay visible.
    proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE)
    out = proc.stdout.strip()

    if not out:
        die("yt-dlp produced no JSON output")

    try:
        info = json.loads(out)
    except json.JSONDecodeError as exc:
        die(f"could not parse yt-dlp JSON: {exc}")

    if proc.returncode != 0:
        warn("yt-dlp returned a non-zero exit code; validating the JSON before writing")

    return info


def clean_cell(value: object) -> str:
    if value is None:
        return ""
    return str(value).replace("\t", " ").replace("\r", " ").replace("\n", " ").strip()


def int_or_none(value: object) -> int | None:
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return None


def video_id_from_entry(entry: dict) -> str:
    vid = clean_cell(entry.get("id"))
    if vid:
        return vid

    webpage_url = clean_cell(entry.get("webpage_url") or entry.get("url"))
    parsed = urlparse(webpage_url)
    host = parsed.netloc.lower().split(":", 1)[0]

    if host.endswith("youtube.com"):
        return clean_cell(parse_qs(parsed.query).get("v", [""])[0])
    if host.endswith("youtu.be"):
        return clean_cell(parsed.path.strip("/").split("/", 1)[0])
    return ""


def canonical_url(video_id: str, entry: dict) -> str:
    if video_id:
        return f"https://www.youtube.com/watch?v={video_id}"
    return clean_cell(entry.get("webpage_url") or entry.get("url"))


def normalize_placeholder_title(title: str) -> str:
    return title.strip().strip("[]").strip().casefold()


def entry_state(entry: dict, video_id: str, title: str, uploader: str) -> str:
    normalized = normalize_placeholder_title(title)
    availability = clean_cell(entry.get("availability")).casefold()

    if normalized in DELETED_TITLES or availability == "deleted":
        return "deleted"
    if normalized in PRIVATE_TITLES or availability == "private":
        return "private"
    if normalized in UNAVAILABLE_TITLES or availability in {"unavailable", "needs_auth"}:
        return "unavailable"

    # In flat playlist output, YouTube/yt-dlp can preserve an unavailable
    # video's ID and playlist position while omitting both title and channel.
    # An ID alone is therefore not evidence that the video is available.
    # On a fresh inventory there is no historical row to distinguish deletion,
    # privacy, region blocking, or another extraction/authentication failure,
    # so the honest status is the broader "unavailable".
    if not title and not uploader:
        return "unavailable"
    if not video_id and not title:
        return "unavailable"
    return "available"


def validate_playlist_completeness(info: dict) -> None:
    entries = info.get("entries")
    if not isinstance(entries, list):
        die("yt-dlp JSON has no playlist entry list")

    expected = int_or_none(info.get("playlist_count"))
    actual = len(entries)

    if expected is not None and actual < expected:
        die(
            f"playlist extraction is incomplete: yt-dlp returned {actual} entries "
            f"but reported playlist_count={expected}; refusing to overwrite the inventory"
        )


def current_rows(info: dict, now: str) -> list[dict[str, str]]:
    entries = info.get("entries") or []
    rows: list[dict[str, str]] = []

    for position, entry in enumerate(entries, start=1):
        if not isinstance(entry, dict):
            warn(f"playlist entry {position} has no metadata object; preserving a blank unavailable row")
            entry = {}

        vid = video_id_from_entry(entry)
        title = clean_cell(entry.get("title"))
        uploader = clean_cell(
            entry.get("uploader")
            or entry.get("channel")
            or entry.get("uploader_id")
            or entry.get("channel_id")
        )
        playlist_index = clean_cell(
            entry.get("playlist_index")
            or entry.get("playlist_autonumber")
            or position
        )
        state = entry_state(entry, vid, title, uploader)

        rows.append(
            {
                "playlist_index": playlist_index,
                "status": state,
                "id": vid,
                "url": canonical_url(vid, entry),
                "title": title,
                "uploader": uploader,
                "first_seen_utc": now,
                "last_seen_utc": now,
                "previous_title": "",
            }
        )

    return rows


def read_previous(path: Path) -> list[dict[str, str]]:
    if not path.exists():
        return []

    with path.open("r", encoding="utf-8", newline="") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        if not reader.fieldnames or "id" not in reader.fieldnames:
            die(f"existing TSV has no 'id' column: {path}")

        return [
            {field: clean_cell(row.get(field, "")) for field in FIELDS}
            for row in reader
            if any(clean_cell(value) for value in row.values())
        ]


def previous_queues(previous: list[dict[str, str]]) -> tuple[dict[str, deque[int]], dict[str, deque[int]]]:
    by_id: dict[str, deque[int]] = defaultdict(deque)
    by_index: dict[str, deque[int]] = defaultdict(deque)

    for pos, row in enumerate(previous):
        if row["id"]:
            by_id[row["id"]].append(pos)
        if row["playlist_index"]:
            by_index[row["playlist_index"]].append(pos)

    return by_id, by_index


def pop_unmatched(queue: deque[int] | None, matched: set[int]) -> int | None:
    if queue is None:
        return None
    while queue and queue[0] in matched:
        queue.popleft()
    return queue.popleft() if queue else None


def sort_index(value: str, fallback: int) -> tuple[int, str, int]:
    parsed = int_or_none(value)
    if parsed is not None:
        return parsed, "", fallback
    return 10**12, value, fallback


def merge_rows(
    current: list[dict[str, str]],
    previous: list[dict[str, str]],
    now: str,
) -> list[dict[str, str]]:
    by_id, by_index = previous_queues(previous)
    matched: set[int] = set()
    output: list[tuple[tuple[int, str, int, int], dict[str, str]]] = []

    for sequence, row in enumerate(current):
        old_pos = pop_unmatched(by_id.get(row["id"]), matched) if row["id"] else None
        if old_pos is None and not row["id"]:
            old_pos = pop_unmatched(by_index.get(row["playlist_index"]), matched)

        old = previous[old_pos] if old_pos is not None else None
        if old_pos is not None:
            matched.add(old_pos)

        detected_state = row["status"]

        if old:
            row["first_seen_utc"] = old.get("first_seen_utc") or now

            if detected_state in {"deleted", "private", "unavailable"}:
                # Playlist placeholders often omit the old ID and metadata. Preserve them.
                row["id"] = row["id"] or old.get("id", "")
                row["url"] = row["url"] or old.get("url", "")
                row["title"] = old.get("title") or row["title"]
                row["uploader"] = old.get("uploader") or row["uploader"]
                row["previous_title"] = old.get("previous_title", "")
            else:
                title_changed = bool(row["title"] and old.get("title") and row["title"] != old.get("title"))
                uploader_changed = bool(
                    row["uploader"] and old.get("uploader") and row["uploader"] != old.get("uploader")
                )

                if title_changed:
                    row["previous_title"] = old.get("title", "")
                else:
                    row["previous_title"] = old.get("previous_title", "")

                if title_changed and uploader_changed:
                    row["status"] = "metadata_changed"
                elif title_changed:
                    row["status"] = "title_changed"
                elif uploader_changed:
                    row["status"] = "uploader_changed"
                else:
                    row["status"] = "ok"
        elif detected_state == "available":
            row["status"] = "new"

        if row["status"] in {"deleted", "private", "unavailable"}:
            warn(f"{row['status'].upper()}: {row['title'] or row['id'] or 'unknown entry'} ({row['id'] or 'no id'})")

        base = sort_index(row["playlist_index"], sequence)
        output.append(((base[0], base[1], base[2], 1), row))

    # IDs absent from the new extraction are retained as historical tombstones.
    # They are placed near their former index rather than dumped into a footer.
    for old_pos, old in enumerate(previous):
        if old_pos in matched:
            continue

        removed = {field: old.get(field, "") for field in FIELDS}
        removed["status"] = "removed"
        # last_seen_utc remains the last time the entry was actually observed.
        warn(f"REMOVED: {removed['title'] or removed['id'] or 'unknown entry'} ({removed['id'] or 'no id'})")
        base = sort_index(removed["playlist_index"], old_pos)
        output.append(((base[0], base[1], base[2], 0), removed))

    output.sort(key=lambda item: item[0])
    return [row for _, row in output]


def write_tsv(path: Path, rows: list[dict[str, str]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    if path.exists():
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        backup = path.with_suffix(path.suffix + f".bak.{stamp}")
        shutil.copy2(path, backup)

    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, delimiter="\t", fieldnames=FIELDS, lineterminator="\n")
        writer.writeheader()
        writer.writerows(rows)

    os.replace(tmp, path)


def main() -> int:
    parser = argparse.ArgumentParser(description="Create or update a durable TSV inventory for a YouTube playlist.")
    parser.add_argument("playlist_url", type=validate_http_url, help="YouTube playlist URL")
    parser.add_argument("--name", help="stable filename stem under ~/Downloads/yt-backup/inventories/")
    parser.add_argument("--cookies", type=Path, help="Netscape cookies.txt for playlists requiring login")
    parser.add_argument("--cookies-from-browser", help="browser name/profile, for example: firefox or chromium")
    args = parser.parse_args()

    if args.cookies and args.cookies_from_browser:
        die("use either --cookies or --cookies-from-browser, not both")
    if args.cookies and not args.cookies.is_file():
        die(f"cookies file does not exist: {args.cookies}")

    require_tool(YTDLP)
    check_ytdlp_version()

    now = utc_now()
    stem = playlist_stem(args.playlist_url, args.name)
    out_path = INVENTORY_DIR / f"{stem}.tsv"

    info = run_ytdlp(args.playlist_url, args)
    validate_playlist_completeness(info)
    rows = current_rows(info, now)
    if not rows:
        die("no playlist entries found")

    previous = read_previous(out_path)
    merged = merge_rows(rows, previous, now)
    write_tsv(out_path, merged)

    current_count = sum(row["status"] != "removed" for row in merged)
    removed_count = sum(row["status"] == "removed" for row in merged)
    unavailable_count = sum(row["status"] in {"deleted", "private", "unavailable"} for row in merged)

    print(f"wrote: {out_path}")
    print(
        f"current playlist rows: {current_count}; "
        f"unavailable placeholders: {unavailable_count}; retained removed rows: {removed_count}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
