#!/usr/bin/env python3
# Usage:
#   yt-audio VIDEO_URL
#   yt-audio PLAYLIST_URL
#   yt-audio URL1 URL2 URL3
#   yt-audio --audio-format m4a VIDEO_URL
#   yt-audio --cookies-from-browser firefox VIDEO_URL
#   yt-audio --cookies ~/path/to/cookies.txt VIDEO_URL
#
# Input:
#   One or more http(s) URLs.
#   This can be a YouTube video URL and, if desired, a playlist URL.
#
# Output:
#   ~/Downloads/yt-backup/audio/<uploader>/
#
# Notes:
#   This script intentionally does not use a yt-dlp download archive.
#   It also does not create timestamped run folders.
#
#   Running it again on the same video will write to the same output path.
#   Existing files are overwritten because --force-overwrites is used.
#
#   This script does not accept TSV files or URL-list files.
#   It only accepts URLs as command-line arguments.

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlparse

BASE_DIR = Path.home() / "Downloads" / "yt-backup"
AUDIO_DIR = BASE_DIR / "audio"
YTDLP = "yt-dlp"


def die(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def require_tool(name: str) -> None:
    if shutil.which(name) is None:
        die(f"required command not found in PATH: {name}")


def validate_url(value: str) -> str:
    parsed = urlparse(value)

    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        die(f"not a valid http(s) URL: {value}")

    return value


def build_command(args: argparse.Namespace) -> list[str]:
    cmd = [
        YTDLP,
        "--no-abort-on-error",
        "--continue",
        "--part",
        "--force-overwrites",
        "--windows-filenames",
        "--trim-filenames",
        "220",
        "--paths",
        str(AUDIO_DIR),
        "--output-na-placeholder",
        "Unknown",
        "--output",
        "%(uploader)s/%(title).200B [%(id)s].%(ext)s",
        "--format",
        "bestaudio/best",
        "--extract-audio",
        "--audio-format",
        args.audio_format,
        "--embed-metadata",
        "--embed-thumbnail",
    ]

    if args.cookies:
        cmd.extend(["--cookies", str(args.cookies)])

    if args.cookies_from_browser:
        cmd.extend(["--cookies-from-browser", args.cookies_from_browser])

    cmd.extend(args.urls)

    return cmd


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Download audio from one or more URLs into ~/Downloads/yt-backup/audio/<uploader>/."
    )

    parser.add_argument(
        "urls",
        nargs="+",
        type=validate_url,
        help="one or more video or playlist URLs",
    )

    parser.add_argument(
        "--audio-format",
        default="best",
        choices=["best", "aac", "alac", "flac", "m4a", "mp3", "opus", "vorbis", "wav"],
        help="default: best, which avoids unnecessary lossy transcoding when possible",
    )

    parser.add_argument(
        "--cookies",
        type=Path,
        help="Netscape cookies.txt for downloads requiring login",
    )

    parser.add_argument(
        "--cookies-from-browser",
        help="browser name/profile, for example: firefox or chromium",
    )

    args = parser.parse_args()

    require_tool(YTDLP)
    require_tool("ffmpeg")
    require_tool("ffprobe")

    AUDIO_DIR.mkdir(parents=True, exist_ok=True)

    cmd = build_command(args)

    print(f"output directory: {AUDIO_DIR}")
    print(f"queued URLs:       {len(args.urls)}")

    proc = subprocess.run(cmd)

    return proc.returncode


if __name__ == "__main__":
    raise SystemExit(main())
