#!/usr/bin/env bash

set -u -o pipefail

# niri-launched processes do not necessarily inherit the PATH configured by interactive zsh.
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:$PATH"

app="download-post"

config="${XDG_CONFIG_HOME:-$HOME/.config}/gallery-dl/${app}.json"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/${app}"
runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/${app}"

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="$app" "$@"
    fi
}

# Check required commands.
for cmd in wl-paste gallery-dl flock sha256sum; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        notify "Download failed" "Required command not found: $cmd"
        exit 127
    fi
done

# Make sure the shortcut-specific gallery-dl config exists.
if [[ ! -r "$config" ]]; then
    notify "Download failed" "Missing config: $config"
    exit 1
fi

install -d -m 700 "$state_dir" "$runtime_dir"

# Read only text from the current Wayland clipboard.
if ! url="$(wl-paste --no-newline --type text 2>/dev/null)"; then
    notify "Download failed" "Could not read text from the clipboard."
    exit 1
fi

# Handle CRLF clipboard contents.
url="${url//$'\r'/}"

# Accept exactly one HTTP(S) URL and nothing else.
if [[ ! "$url" =~ ^https?://[^[:space:]]+$ ]]; then
    notify \
        "Download failed" \
        "Clipboard does not contain exactly one HTTP(S) URL."
    exit 1
fi

# Prevent repeated hotkey presses for the same URL from starting
# simultaneous downloads.
lock_id="$(printf '%s' "$url" | sha256sum | cut -d' ' -f1)"

exec 9>"$runtime_dir/$lock_id.lock"

if ! flock -n 9; then
    notify "Already downloading" "That URL is already being processed."
    exit 0
fi

# Keep normal logs only for the lifetime of this invocation.
log_file="$(mktemp "$runtime_dir/run.XXXXXX.log")"
trap 'rm -f "$log_file"' EXIT

notify "Downloading post" "$url"

if gallery-dl -c "$config" -- "$url" >"$log_file" 2>&1; then
    notify "Download finished" "$url"
else
    # Keep only the most recent failure, capped at 200 lines.
    tail -n 200 "$log_file" >"$state_dir/last-error.log"

    notify \
        "Download failed" \
        "See $state_dir/last-error.log"

    exit 1
fi
