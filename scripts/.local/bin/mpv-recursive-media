#!/usr/bin/env bash
# Recursively opens all images/videos below a directory in mpv, grouping media
# by folder and sorting both folders and files by modification time.
# Arrow keys move between files; Shift+Arrow jumps between folder playlists.

set -euo pipefail

gui=0

if [[ "${1:-}" == "--gui" ]]; then
    gui=1
    shift
fi

usage() {
    printf 'Usage: %s [DIRECTORY]\n' "${0##*/}" >&2
}

fail() {
    local message="$1"

    printf 'mpv-recursive-media: %s\n' "$message" >&2

    if (( gui )) && command -v zenity >/dev/null 2>&1; then
        zenity \
            --error \
            --title='Recursive Media' \
            --text="$message" \
            2>/dev/null || true
    fi

    exit 1
}

if (( $# > 1 )); then
    usage
    exit 2
fi

# ---------------------------------------------------------------------------
# Choose root directory
# ---------------------------------------------------------------------------

if (( $# == 1 )); then
    root="$1"

elif (( gui )); then
    command -v zenity >/dev/null 2>&1 ||
        fail "zenity is required when launched graphically."

    root="$(
        zenity \
            --file-selection \
            --directory \
            --title='Choose media folder'
    )" || exit 0

    [[ -n "$root" ]] || exit 0

else
    root="$PWD"
fi

[[ -d "$root" ]] || fail "Not a directory: $root"

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------

for cmd in mpv find sort cut mktemp readlink; do
    command -v "$cmd" >/dev/null 2>&1 ||
        fail "Required command not found: $cmd"
done

root="$(readlink -f -- "$root")"

input_conf="$HOME/.config/mpv/recursive-media-input.conf"

[[ -f "$input_conf" ]] ||
    fail "Missing input configuration: $input_conf"

# ---------------------------------------------------------------------------
# Temporary playlist storage
# ---------------------------------------------------------------------------

umask 077

runtime_base="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"

state_dir="$(
    mktemp -d \
        --tmpdir="$runtime_base" \
        'mpv-recursive-media.XXXXXX'
)"

trap 'rm -rf -- "$state_dir"' EXIT HUP INT TERM

# ---------------------------------------------------------------------------
# Supported media
# ---------------------------------------------------------------------------

media_expr=(
    \(
        -iname '*.jpg'  -o
        -iname '*.jpeg' -o
        -iname '*.png'  -o
        -iname '*.webp' -o
        -iname '*.gif'  -o
        -iname '*.bmp'  -o
        -iname '*.tif'  -o
        -iname '*.tiff' -o
        -iname '*.avif' -o
        -iname '*.heic' -o
        -iname '*.heif' -o
        -iname '*.jxl'  -o

        -iname '*.mp4'  -o
        -iname '*.mkv'  -o
        -iname '*.webm' -o
        -iname '*.avi'  -o
        -iname '*.mov'  -o
        -iname '*.m4v'  -o
        -iname '*.mpg'  -o
        -iname '*.mpeg' -o
        -iname '*.wmv'  -o
        -iname '*.flv'  -o
        -iname '*.ts'   -o
        -iname '*.mts'  -o
        -iname '*.m2ts' -o
        -iname '*.ogv'  -o
        -iname '*.3gp'  -o
        -iname '*.3g2'  -o
        -iname '*.vob'
    \)
)

# ---------------------------------------------------------------------------
# Directory ordering
#
# The root directory itself is always first.
#
# All subdirectories are ordered by THEIR OWN modification time:
# oldest -> newest.
#
# Directory mtime changes when entries directly inside the directory are
# created, removed or renamed.
# ---------------------------------------------------------------------------

dirs=("$root")

while IFS= read -r -d '' rec; do
    dirs+=("${rec#*$'\t'}")
done < <(
    find "$root" \
        -mindepth 1 \
        -type d \
        -printf '%T@\t%p\0' |
    LC_ALL=C sort \
        -z \
        -t $'\t' \
        -k1,1n \
        -k2,2V
)

# ---------------------------------------------------------------------------
# Build one playlist per directory.
#
# Files within each directory are also ordered by mtime:
# oldest -> newest.
# ---------------------------------------------------------------------------

playlists=()

group_count=0
file_count=0

for dir in "${dirs[@]}"; do
    mapfile -d '' files < <(
        find "$dir" \
            -mindepth 1 \
            -maxdepth 1 \
            -type f \
            "${media_expr[@]}" \
            -printf '%T@\t%p\0' |
        LC_ALL=C sort \
            -z \
            -t $'\t' \
            -k1,1n \
            -k2,2V |
        cut -z -f2-
    )

    (( ${#files[@]} == 0 )) && continue

    printf -v playlist \
        '%s/%06d.m3u' \
        "$state_dir" \
        "$group_count"

    {
        printf '#EXTM3U\n'

        for file in "${files[@]}"; do
            printf '%s\n' "$file"
        done
    } > "$playlist"

    playlists+=("$playlist")

    ((group_count += 1))
    ((file_count += ${#files[@]}))
done

(( file_count > 0 )) ||
    fail "No supported image or video files found below: $root"

printf \
    'Opening %d media files from %d folders under %s\n' \
    "$file_count" \
    "$group_count" \
    "$root" \
    >&2

# ---------------------------------------------------------------------------
# Launch mpv.
#
# Each M3U is passed as a separate playlist input. mpv expands playlist
# entries and remembers their originating playlist, which lets
# playlist-next-playlist / playlist-prev-playlist jump between folders.
# ---------------------------------------------------------------------------

if ! mpv \
    --input-conf="$input_conf" \
    --image-display-duration=inf \
    --keep-open=yes \
    -- \
    "${playlists[@]}"
then
    fail "mpv exited with an error."
fi
