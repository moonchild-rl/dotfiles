#!/usr/bin/env bash
# Recursively opens images/videos in mpv from a directory or a clicked media
# file, grouping media by folder and sorting folders/files by modification time.
# Arrow keys move between files; Shift+Arrow jumps between folder playlists.

set -euo pipefail

gui=0

if [[ "${1:-}" == "--gui" ]]; then
    gui=1
    shift
fi

usage() {
    printf 'Usage: %s [FILE_OR_DIRECTORY]\n' "${0##*/}" >&2
}

fail() {
    local message="$1"

    printf 'mpv-recursive-media: %s\n' "$message" >&2

    if (( gui )) && command -v zenity >/dev/null 2>&1; then
        zenity \
            --error \
            --title='Recursive Media' \
            --text="$message" \
            2>/dev/null || true
    fi

    exit 1
}

if (( $# > 1 )); then
    usage
    exit 2
fi

# ---------------------------------------------------------------------------
# Choose file or root directory
# ---------------------------------------------------------------------------

if (( $# == 1 )); then
    target="$1"

elif (( gui )); then
    command -v zenity >/dev/null 2>&1 ||
        fail "zenity is required when launched graphically."

    target="$(
        zenity \
            --file-selection \
            --directory \
            --title='Choose media folder'
    )" || exit 0

    [[ -n "$target" ]] || exit 0

else
    target="$PWD"
fi

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------

for cmd in mpv find sort cut mktemp readlink dirname; do
    command -v "$cmd" >/dev/null 2>&1 ||
        fail "Required command not found: $cmd"
done

target="$(readlink -f -- "$target")"

clicked=""

if [[ -d "$target" ]]; then
    root="$target"

elif [[ -f "$target" ]]; then
    clicked="$target"
    root="$(dirname -- "$target")"

else
    fail "Not a file or directory: $target"
fi

input_conf="$HOME/.config/mpv/recursive-media-input.conf"

[[ -f "$input_conf" ]] ||
    fail "Missing input configuration: $input_conf"

# ---------------------------------------------------------------------------
# Temporary playlist storage
# ---------------------------------------------------------------------------

umask 077

runtime_base="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"

state_dir="$(
    mktemp -d \
        --tmpdir="$runtime_base" \
        'mpv-recursive-media.XXXXXX'
)"

trap 'rm -rf -- "$state_dir"' EXIT HUP INT TERM

# ---------------------------------------------------------------------------
# Supported media
# ---------------------------------------------------------------------------

media_expr=(
    \(
        -iname '*.jpg'  -o
        -iname '*.jpeg' -o
        -iname '*.png'  -o
        -iname '*.webp' -o
        -iname '*.gif'  -o
        -iname '*.bmp'  -o
        -iname '*.tif'  -o
        -iname '*.tiff' -o
        -iname '*.avif' -o
        -iname '*.heic' -o
        -iname '*.heif' -o
        -iname '*.jxl'  -o

        -iname '*.mp4'  -o
        -iname '*.mkv'  -o
        -iname '*.webm' -o
        -iname '*.avi'  -o
        -iname '*.mov'  -o
        -iname '*.m4v'  -o
        -iname '*.mpg'  -o
        -iname '*.mpeg' -o
        -iname '*.wmv'  -o
        -iname '*.flv'  -o
        -iname '*.ts'   -o
        -iname '*.mts'  -o
        -iname '*.m2ts' -o
        -iname '*.ogv'  -o
        -iname '*.3gp'  -o
        -iname '*.3g2'  -o
        -iname '*.vob'
    \)
)

# ---------------------------------------------------------------------------
# Directory ordering
#
# The root directory itself is always first.
#
# All subdirectories are ordered by THEIR OWN modification time:
# oldest -> newest.
# ---------------------------------------------------------------------------

dirs=("$root")

while IFS= read -r -d '' rec; do
    dirs+=("${rec#*$'\t'}")
done < <(
    find "$root" \
        -mindepth 1 \
        -type d \
        -printf '%T@\t%p\0' |
    LC_ALL=C sort \
        -z \
        -t $'\t' \
        -k1,1n \
        -k2,2V
)

# ---------------------------------------------------------------------------
# Build one playlist per directory.
#
# Files within each directory are ordered by mtime:
# oldest -> newest.
#
# If a specific media file was opened, remember its index within the root
# playlist. The clicked file always belongs to the root directory because the
# containing directory becomes the root.
# ---------------------------------------------------------------------------

playlists=()

group_count=0
file_count=0

clicked_found=0
start_index=0

for dir in "${dirs[@]}"; do
    mapfile -d '' files < <(
        find "$dir" \
            -mindepth 1 \
            -maxdepth 1 \
            -type f \
            "${media_expr[@]}" \
            -printf '%T@\t%p\0' |
        LC_ALL=C sort \
            -z \
            -t $'\t' \
            -k1,1n \
            -k2,2V |
        cut -z -f2-
    )

    (( ${#files[@]} == 0 )) && continue

    printf -v playlist \
        '%s/%06d.m3u' \
        "$state_dir" \
        "$group_count"

    {
        printf '#EXTM3U\n'

        for i in "${!files[@]}"; do
            file="${files[i]}"

            if [[ -n "$clicked" && "$file" == "$clicked" ]]; then
                start_index="$i"
                clicked_found=1
            fi

            printf '%s\n' "$file"
        done
    } > "$playlist"

    playlists+=("$playlist")

    ((group_count += 1))
    ((file_count += ${#files[@]}))
done

(( file_count > 0 )) ||
    fail "No supported image or video files found below: $root"

if [[ -n "$clicked" ]] && (( ! clicked_found )); then
    fail "The selected file is not a supported media file: $clicked"
fi

printf \
    'Opening %d media files from %d folders under %s\n' \
    "$file_count" \
    "$group_count" \
    "$root" \
    >&2

# ---------------------------------------------------------------------------
# Launch mpv.
#
# Each M3U remains a separate playlist so playlist-next-playlist and
# playlist-prev-playlist can jump between folders.
#
# When launched from a specific media file, the first playlist is the file's
# containing directory. Once mpv expands it, jump to that file's index.
# ---------------------------------------------------------------------------

mpv_args=(
    --input-conf="$input_conf"
    --image-display-duration=inf
    --keep-open=yes
)

if [[ -n "$clicked" ]]; then
    mpv_args+=(
        --input-commands="playlist-play-index $start_index"
    )
fi

if ! mpv \
    "${mpv_args[@]}" \
    -- \
    "${playlists[@]}"
then
    fail "mpv exited with an error."
fi
