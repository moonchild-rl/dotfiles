#!/usr/bin/env python3
"""Single-instance VLC with on-demand directory navigation (Linux, VLC 3.x)."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time
from urllib.parse import quote, unquote, urlsplit
import uuid


def atomic_write(path, text):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(text, encoding="utf-8")
    temporary.replace(path)


def process_stamp(pid):
    """Include Linux's process start time so a recycled PID cannot look alive."""
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return None if fields[0] == "Z" else fields[19]
    except (OSError, IndexError):
        return None


def running(state):
    try:
        instance = json.loads((state / "instance.json").read_text())
        if instance["stamp"] and process_stamp(instance["pid"]) == instance["stamp"]:
            return instance
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return None


def local_path(value):
    if value.startswith("file:"):
        uri = urlsplit(value)
        if uri.netloc not in ("", "localhost"):
            raise ValueError("Only local file URLs are supported")
        value = unquote(uri.path)
    return Path(value).expanduser().resolve()


def vlc_command():
    # Settings are per launch. Avoid media-library loading, network metadata,
    # preparsing and saved playlists; navigation belongs to the Lua interface.
    return [
        "vlc", "--ignore-config", "--intf=qt", "--no-one-instance",
        "--no-one-instance-when-started-from-file", "--no-dbus",
        "--no-media-library", "--no-auto-preparse",
        "--no-metadata-network-access", "--no-sub-autodetect-file",
        "--no-qt-privacy-ask",
        "--no-qt-video-autoresize", "--no-video-title-show",
        "--extraintf=luaintf", "--lua-intf=vlc_lazy",
        "--repeat", "--no-loop", "--file-caching=100",
        "--key-next=Right\tn", "--key-nav-right=",
        "--key-jump+medium=", "--extrashort-jump-size=5",
    ]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("target", nargs="?", help="Media file or directory")
    parser.add_argument("--root", help="Ancestor directory to traverse")
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument("--next", action="store_true", help="Next media")
    actions.add_argument("--next-folder", action="store_true", help="Skip this subtree")
    actions.add_argument("--status", action="store_true", help="Show current file and playback state")
    args = parser.parse_args()
    action = ("next" if args.next else "next-folder" if args.next_folder
              else "status" if args.status else "open")
    if (action == "open") != bool(args.target):
        parser.error("Supply a target, or one of --next, --next-folder, --status")
    if args.root and action != "open":
        parser.error("--root requires a target")
    target = root = ""
    if args.target:
        try:
            target = local_path(args.target)
            root = local_path(args.root) if args.root else (target if target.is_dir() else target.parent)
        except ValueError as error:
            parser.error(str(error))
        if not target.is_file() and not target.is_dir():
            parser.error(f"Not a file or directory: {target}")
        if not root.is_dir() or (target != root and root not in target.parents):
            parser.error("--root must be an existing ancestor of the target")

    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        parser.error("XDG_RUNTIME_DIR is unset; launch from a desktop session")
    state = Path(runtime) / "vlc-lazy"
    state.mkdir(mode=0o700, exist_ok=True)
    state.chmod(0o700)
    with (state / "lock").open("w") as lock:
        # Serialize simultaneous double clicks and all request/ack exchanges.
        fcntl.flock(lock, fcntl.LOCK_EX)
        instance = running(state)
        if not instance and action != "open":
            parser.error("No vlc-lazy instance is running")
        request_id = uuid.uuid4().hex
        token = instance["token"] if instance else uuid.uuid4().hex
        payload = "\n".join((token, request_id, action, quote(str(target), safe="/"), quote(str(root), safe="/"))) + "\n"
        atomic_write(state / "request", payload)
        proc = None
        if not instance:
            env = dict(os.environ, VLC_LAZY_STATE=str(state), VLC_LAZY_TOKEN=token)
            try:
                with (state / "vlc.log").open("w") as log:
                    proc = subprocess.Popen(vlc_command(), env=env,
                                            stdin=subprocess.DEVNULL, stdout=log,
                                            stderr=subprocess.STDOUT, start_new_session=True)
            except FileNotFoundError:
                parser.error("VLC is not installed")
            instance = {"pid": proc.pid, "stamp": process_stamp(proc.pid), "token": token}
            atomic_write(state / "instance.json", json.dumps(instance))

        # Acknowledgement means the Lua handlers loaded and accepted the file.
        deadline = time.monotonic() + (10 if proc else 5)
        while time.monotonic() < deadline:
            try:
                reply = (state / "reply").read_text().split("\n", 3)
                if reply[:2] == [token, request_id]:
                    if reply[2] != "ok":
                        parser.error(unquote(reply[3].rstrip("\n")))
                    if action == "status":
                        print(unquote(reply[3].rstrip("\n")))
                    return 0
            except OSError:
                pass
            if process_stamp(instance["pid"]) != instance["stamp"]:
                break
            time.sleep(0.01)
        # A failed startup must not leave an unmanaged VLC window/process.
        if proc and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
        log = state / "vlc.log"
        try:
            tail = "\n".join(log.read_text(errors="replace").splitlines()[-12:])
        except OSError:
            tail = "(no log available)"
        parser.error(f"VLC control interface did not respond. Check {log}:\n{tail}")


if __name__ == "__main__":
    sys.exit(main())
